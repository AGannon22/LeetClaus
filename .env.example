# Copy to .env and change the password for production.
MONGO_USER=root
MONGO_PASSWORD=rootpassword

DB_NAME=leetclause

# Signs session cookies. Generate your own:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Used when running `python app.py` on your machine (Docker sets these itself)
MONGO_HOST=localhost
MONGO_PORT=27017
LEETCODE_API_URL=http://localhost:3000/
